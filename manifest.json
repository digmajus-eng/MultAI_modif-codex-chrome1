{
  "manifest_version": 3,
  "name": "MultAI",
  "version": "0.1.2",
  "description": "Ask multiple AI chat sites in parallel from one cockpit.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "MultAI \u2014 open cockpit",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://meta.ai/*",
    "https://*.meta.ai/*",
    "https://giga.chat/*",
    "https://*.giga.chat/*",
    "https://alice.yandex.ru/*",
    "https://ya.ru/alice/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://*.kimi.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://chat.z.ai/*",
    "https://*.z.ai/*",
    "https://yuanbao.tencent.com/*",
    "https://*.yuanbao.tencent.com/*",
    "https://www.google.com/*",
    "https://google.com/*",
    "https://search.brave.com/*",
    "https://chat.mistral.ai/*",
    "https://mistral.ai/*",
    "https://www.mistral.ai/*",
    "https://copilot.cloud.microsoft/*",
    "https://*.cloud.microsoft/*",
    "https://yandex.ru/*",
    "https://www.yandex.ru/*",
    "https://yandex.com/*",
    "https://www.yandex.com/*",
    "https://dzen.ru/*",
    "https://*.dzen.ru/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "iframe-headers",
        "enabled": true,
        "path": "rules/iframe-headers.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://*.qwen.ai/*",
        "https://meta.ai/*",
        "https://*.meta.ai/*",
        "https://giga.chat/*",
        "https://*.giga.chat/*",
        "https://alice.yandex.ru/*",
        "https://ya.ru/alice/*",
        "https://www.kimi.ai/*",
        "https://kimi.ai/*",
        "https://*.kimi.ai/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://chat.z.ai/*",
        "https://*.z.ai/*",
        "https://yuanbao.tencent.com/*",
        "https://*.yuanbao.tencent.com/*",
        "https://www.google.com/*",
        "https://google.com/*",
        "https://search.brave.com/*",
        "https://chat.mistral.ai/*",
        "https://mistral.ai/*",
        "https://www.mistral.ai/*",
        "https://copilot.cloud.microsoft/*",
        "https://*.cloud.microsoft/*",
        "https://yandex.ru/*",
        "https://www.yandex.ru/*",
        "https://yandex.com/*",
        "https://www.yandex.com/*",
        "https://dzen.ru/*",
        "https://*.dzen.ru/*"
      ],
      "js": [
        "src/shared/anti-framebust.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/chatgpt/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/claude/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/gemini/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*",
        "https://*.grok.com/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/grok/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/deepseek/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*",
        "https://*.qwen.ai/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/qwen/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meta.ai/*",
        "https://*.meta.ai/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/meta/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://giga.chat/*",
        "https://*.giga.chat/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/gigachat/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://alice.yandex.ru/*",
        "https://ya.ru/alice/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/alice/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kimi.ai/*",
        "https://kimi.ai/*",
        "https://*.kimi.ai/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/kimi/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/perplexity/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.z.ai/*",
        "https://*.z.ai/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/zai/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yuanbao.tencent.com/*",
        "https://*.yuanbao.tencent.com/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/yuanbao/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/google-ai/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://search.brave.com/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/brave-search/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.mistral.ai/*",
        "https://mistral.ai/*",
        "https://www.mistral.ai/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/mistral/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://copilot.cloud.microsoft/*",
        "https://*.cloud.microsoft/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/copilot/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://yandex.ru/*",
        "https://www.yandex.ru/*",
        "https://yandex.com/*",
        "https://www.yandex.com/*",
        "https://dzen.ru/*",
        "https://*.dzen.ru/*"
      ],
      "js": [
        "src/providers/_runtime.js",
        "src/providers/_generic.js",
        "src/providers/yandex-search/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://chatgpt.com https://*.chatgpt.com https://claude.ai https://*.claude.ai https://gemini.google.com https://grok.com https://*.grok.com https://chat.deepseek.com https://*.deepseek.com https://chat.qwen.ai https://*.qwen.ai https://meta.ai https://*.meta.ai https://giga.chat https://*.giga.chat https://alice.yandex.ru https://ya.ru https://yandex.ru https://www.yandex.ru https://*.yandex.ru https://kimi.ai https://*.kimi.ai https://perplexity.ai https://*.perplexity.ai https://chat.z.ai https://*.z.ai https://yuanbao.tencent.com https://*.yuanbao.tencent.com https://google.com https://*.google.com https://search.brave.com https://mistral.ai https://*.mistral.ai https://copilot.cloud.microsoft https://*.cloud.microsoft https://yandex.com https://www.yandex.com https://*.yandex.com https://dzen.ru https://*.dzen.ru"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
